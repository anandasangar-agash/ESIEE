6. static void printReceipt(List<Article> articles) {
	  var sum = 0L;
	  for (var article : articles) {
	    sum += switch (article) {
	      case Lego(int quantity, String name) -> (long) quantity * name.length() * 20;
	      case Beer(int quantity, BeerKind kind) ->
	          kind == BeerKind.BLONDE ? (long) quantity : 3L * quantity;
	    };
	  }
	  IO.println("sum: " + sum);
	  
	  var partition = articles.stream().collect(Collectors.partitioningBy(article -> switch (article) {
		  case Lego _ -> true;
		  case Beer _ -> false;
		}));
		
	  partition.get(true).stream()
	      .map(article -> (Lego) article)
	      .max(Comparator.comparingInt((Lego lego) -> lego.name().length()))
	      .ifPresent(lego -> IO.println("max lego: " + lego.name()));
	}
	
